#
# system.prop for mt6785
#

# Audio
ro.audio.silent=0

# Audio Volume Steps
ro.config.media_vol_steps=20

# Battery Saving
persist.radio.add_power_save=1
pm.sleep_mode=1
ro.ril.disable.power.collapse=0
ro.ril.fast.dormancy.rule=1
ro.ril.fast.dormancy.timeout=3
ro.mot.eri.losalert.delay=100
ro.vold.umsdirtyratio=20

# Bluetooth
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false

# Brand
Build.BRAND=MTK

# Blur
ro.sf.blurs_are_expensive=1

# Camera
ro.camera.sound.forced=0

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Display
persist.vendor.dc_backlight.enable=false
ro.display.type=oled
vendor.hbm.enable=true

# Fingerprint
ro.hardware.fp.sideCap=true

# GPU
ro.opengles.version=196610

# IMS
persist.data.iwlan=1
persist.data.iwlan.enable=true
persist.data.iwlan.ipsec.ap=1
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.radio.calls.on.ims=1
persist.radio.data_ltd_sys_ind=1
persist.radio.data_con_rprt=1
persist.radio.rat_on=combine
persist.radio.VT_HYBRID_ENABLE=1
persist.sys.phh.ims.caf=true
persist.sys.strictmode.disable=true
persist.vendor.ims.enabled=1
persist.vendor.ims.enable_ims=1
persist.vendor.radio.calls.on.ims=1
persist.vendor.radio.force_on_dc=true
persist.vendor.radio.data_ltd_sys_ind=1
persist.vendor.radio.data_con_rprt=1
persist.vendor.wfc.ims.enabled=1
ro.vendor.radio.5g=3
persist.dbg.vonr_avail_ovr=1
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
persist.radio.nr_mode=3
persist.vendor.radio.5g=3
persist.vendor.radio.5g_mode_pref=3
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Kernel
ro.kernel.zio=38,108,105,16
sys.ipo.disable=1
sys.ipo.pwrdncap=2
ro.iorapd.enable=false

# Logging
persist.sys.mdlog_dumpback=2

# Radio
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1
persist.rcs.supported=1

# MIUI
ro.miui.build.region=global

# Perf
ro.mtk_perf_simple_start_win=1
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1

# RIL
vendor.rild.libpath=mtk-ril.so
vendor.rild.libargs=-d /dev/ttyC0

# USB
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
persist.vendor.otg_control=true

# WiFi
wifi.interface=wlan0
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# ZRAM
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=1440
ro.zram.periodic_wb_delay_hours=24
